{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/create-order",
      "destination": "/api/create-order.js"
    },
    {
      "source": "/download-apk",
      "destination": "/api/download-apk"
    },
    {
      "source": "/__/auth/:path*",
      "destination": "https://jiyarul-store.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/store",
      "destination": "/index.html"
    }
  ]
}
